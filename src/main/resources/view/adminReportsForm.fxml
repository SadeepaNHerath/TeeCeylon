<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="909.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.form_controllers.AdminReportsFormController">
   <left>
      <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #f0f0f0;">
         <padding>
            <Insets bottom="15" left="10" right="10" top="15" />
         </padding>
         <children>
            <ImageView fitHeight="33.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../img/header-removebg-preview.png" />
               </image>
            </ImageView>
            <JFXButton fx:id="reportsBtn" onAction="#reportsBtnOnAction" prefHeight="27.0" prefWidth="126.0" style="-fx-background-color: #2196F3; -fx-background-radius: 5px;" text="Dashboard" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </JFXButton>
            <JFXButton fx:id="suppliersBtn" onAction="#suppliersBtnOnAction" prefHeight="27.0" prefWidth="126.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 5px;" text="Suppliers" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </JFXButton>
            <JFXButton fx:id="cashiersBtn" onAction="#cashiersBtnOnAction" prefHeight="27.0" prefWidth="126.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 5px;" text="Employee" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </JFXButton>
            <JFXButton fx:id="inventoryBtn" onAction="#inventoryBtnOnAction" prefHeight="27.0" prefWidth="126.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 5px;" text="Inventory" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </JFXButton>
            <JFXButton fx:id="orderDetailsBtn" onAction="#orderDetailsBtnOnAction" prefHeight="27.0" prefWidth="126.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 5px;" text="Orders" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </JFXButton>
            <JFXButton fx:id="purchasesBtn" onAction="#purchasesBtnOnAction" prefHeight="27.0" prefWidth="126.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 5px;" text="Purchases (GRN)" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </JFXButton>
            <Button fx:id="logoutBtn" onAction="#logoutBtnOnAction" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Logout" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ffffff;">
               <padding>
                  <Insets bottom="10" left="20" right="20" top="10" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 22; -fx-font-weight: bold;" text="Admin Dashboard &amp; Analytics" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label prefHeight="37.0" prefWidth="60.0" text="Date :" textFill="#0d0000">
                     <font>
                        <Font name="Century Gothic" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="dateTxt" alignment="CENTER_RIGHT" prefHeight="54.0" prefWidth="111.0" text="2026-08-31" textFill="#140000">
                     <font>
                        <Font name="Century Gothic" size="16.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Export PDF Quick Action Bar -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #eef2f5; -fx-padding: 8 20 8 20;">
               <children>
                  <Label text="Export Reports:" textFill="#333333">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <JFXButton fx:id="exportSalesPdfBtn" onAction="#exportSalesPdfBtnOnAction" style="-fx-background-color: #2196F3;" text="Sales Report PDF" textFill="WHITE">
                     <font><Font name="System Bold" size="11.0" /></font>
                  </JFXButton>
                  <JFXButton fx:id="exportInventoryPdfBtn" onAction="#exportInventoryPdfBtnOnAction" style="-fx-background-color: #4CAF50;" text="Inventory PDF" textFill="WHITE">
                     <font><Font name="System Bold" size="11.0" /></font>
                  </JFXButton>
                  <JFXButton fx:id="exportPurchasesPdfBtn" onAction="#exportPurchasesPdfBtnOnAction" style="-fx-background-color: #FF9800;" text="Purchases PDF" textFill="WHITE">
                     <font><Font name="System Bold" size="11.0" /></font>
                  </JFXButton>
                  <JFXButton fx:id="exportSuppliersPdfBtn" onAction="#exportSuppliersPdfBtnOnAction" style="-fx-background-color: #607D8B;" text="Suppliers PDF" textFill="WHITE">
                     <font><Font name="System Bold" size="11.0" /></font>
                  </JFXButton>
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
               <content>
                  <VBox prefWidth="720.0" spacing="15" style="-fx-background-color: #f8f8f8;">
                     <padding>
                        <Insets bottom="15" left="15" right="15" top="15" />
                     </padding>
                     <children>
                        <!-- KPI Metric Cards Bar -->
                        <HBox spacing="10.0">
                           <children>
                              <VBox alignment="CENTER" prefHeight="65.0" prefWidth="165.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #2196F3; -fx-border-radius: 8;">
                                 <children>
                                    <Label text="Month Sales (Rs)" textFill="#666666"><font><Font size="11.0" /></font></Label>
                                    <Label fx:id="monthSalesLbl" text="Rs. 0.00" textFill="#2196F3"><font><Font name="System Bold" size="14.0" /></font></Label>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefHeight="65.0" prefWidth="165.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #4CAF50; -fx-border-radius: 8;">
                                 <children>
                                    <Label text="Items Sold This Month" textFill="#666666"><font><Font size="11.0" /></font></Label>
                                    <Label fx:id="itemsSoldLbl" text="0 Units" textFill="#4CAF50"><font><Font name="System Bold" size="14.0" /></font></Label>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefHeight="65.0" prefWidth="165.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #FF9800; -fx-border-radius: 8;">
                                 <children>
                                    <Label text="Total Stock In Hand" textFill="#666666"><font><Font size="11.0" /></font></Label>
                                    <Label fx:id="totalStockLbl" text="0 Units" textFill="#FF9800"><font><Font name="System Bold" size="14.0" /></font></Label>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefHeight="65.0" prefWidth="165.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #F44336; -fx-border-radius: 8;">
                                 <children>
                                    <Label text="Low Stock Alerts" textFill="#666666"><font><Font size="11.0" /></font></Label>
                                    <Label fx:id="lowStockLbl" text="0 SKUs" textFill="#F44336"><font><Font name="System Bold" size="14.0" /></font></Label>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <VBox prefHeight="220.0" spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Product Stock by Category (Gents / Ladies / Kids)" />
                              <PieChart fx:id="productReportChart" prefHeight="180.0" />
                           </children>
                        </VBox>

                        <VBox prefHeight="220.0" spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Monthly Sales Distribution" />
                              <PieChart fx:id="monthlySalesReportChart" prefHeight="180.0" />
                           </children>
                        </VBox>

                        <VBox prefHeight="220.0" spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Annual Sales by Month" />
                              <PieChart fx:id="annualSalesReportChart" prefHeight="180.0" />
                           </children>
                        </VBox>

                        <VBox prefHeight="220.0" spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Today's Sales Breakdown" />
                              <PieChart fx:id="dailySalesReportChart" prefHeight="180.0" />
                           </children>
                        </VBox>

                        <VBox prefHeight="220.0" spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Inventory per Supplier" />
                              <PieChart fx:id="supplierReportChart" prefHeight="180.0" />
                           </children>
                        </VBox>

                        <VBox prefHeight="220.0" spacing="5" style="-fx-background-color: white; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Sales Handled by Cashiers" />
                              <PieChart fx:id="cashierReportChart" prefHeight="180.0" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>
